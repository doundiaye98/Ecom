# ============================================
# Pure Essence Vita — Configuration (.env)
# Copiez ce fichier en .env :  cp .env.example .env
# ============================================

# --- Application ---
APP_ENV=local
APP_URL=http://localhost/Ecom
APP_TIMEZONE=Africa/Dakar
APP_DEBUG=true

# Limites requêtes / minute / IP (anti-surcharge)
RATE_LIMIT_GET=180
RATE_LIMIT_POST=40

# --- Mode paiement ---
# sandbox   = simulation locale SANS clés API (développement)
# production = clés API obligatoires, aucune simulation
PAYMENT_MODE=sandbox

PAYMENT_CURRENCY=XOF
PAYMENT_COUNTRY=SN
PAYMENT_MIN_AMOUNT=200
PAYMENT_MAX_AMOUNT=5000000
# Moyens actifs : wave, orange, cod (livraison)
PAYMENT_METHODS=wave,orange,cod

# --- Wave (Sénégal) ---
# Portail : https://business.wave.com → Développeurs
# Doc API : https://docs.wave.com/checkout
WAVE_ENABLED=true
WAVE_API_KEY=
# aggregated_merchant_id — laisser vide si compte marchand direct
WAVE_MERCHANT_ID=
WAVE_API_URL=https://api.wave.com/v1
# Secret webhook (whsec_…) — URL callback :
# https://VOTRE-DOMAINE/api/payments.php?action=webhook_wave
WAVE_WEBHOOK_SECRET=

# --- Orange Money WebPay (Sénégal) ---
# Portail : https://developer.orange.com
ORANGE_MONEY_ENABLED=true
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
OM_API_URL=https://api.orange.com/orange-money-webpay/snp/v1
# URL callback :
# https://VOTRE-DOMAINE/api/payments.php?action=webhook_orange
OM_WEBHOOK_SECRET=

# --- Chatbot & WhatsApp ---
CHATBOT_ENABLED=true
WHATSAPP_NUMBER=221771234567
CHATBOT_BRAND_NAME=Pure Essence Vita
CHATBOT_AGENT_NAME=Essence
CHATBOT_WELCOME=Bonjour ! Je suis Essence, votre assistante Pure Essence Vita. Comment puis-je vous aider ?
CHATBOT_FALLBACK=Je n'ai pas bien compris. Choisissez une option ci-dessous ou contactez-nous sur WhatsApp.

# --- Base de données (optionnel — install.php génère config/database.php) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pure_essence_vita
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# CHECKLIST DÉPLOIEMENT PRODUCTION
# ============================================
# 1. APP_URL=https://votre-domaine.com  (HTTPS obligatoire)
# 2. PAYMENT_MODE=production
# 3. Renseigner WAVE_API_KEY (+ WAVE_MERCHANT_ID si agrégateur)
# 4. Renseigner OM_CLIENT_ID, OM_CLIENT_SECRET, OM_MERCHANT_KEY
# 5. Configurer webhooks Wave et Orange vers les URLs ci-dessus
# 6. WHATSAPP_NUMBER=221XXXXXXXXX (votre numéro réel)
# 7. Vérifier : GET /api/payments.php?action=check  → ready: true
# ============================================
